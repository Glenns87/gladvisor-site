---
// Primair: --ink vlak met crème tekst. Secundair: rand in --ink.
// Hover: gouden onderrand. Zonder href wordt het een <button>.
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary';
  type?: 'button' | 'submit';
  class?: string;
}

const { href, variant = 'primary', type = 'button', class: className } = Astro.props;
const classes = ['button', `button--${variant}`, className];
---

{
  href ? (
    <a href={href} class:list={classes}>
      <slot />
    </a>
  ) : (
    <button type={type} class:list={classes}>
      <slot />
    </button>
  )
}

<style>
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 12px var(--space-3);
    border: 2px solid var(--ink);
    border-radius: 0;
    font-family: var(--font);
    font-size: 16px;
    font-weight: var(--weight-bold);
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
    cursor: pointer;
  }

  .button:hover {
    border-bottom-color: var(--gold);
  }

  .button--primary {
    background: var(--ink);
    color: var(--bg);
  }

  .button--secondary {
    background: transparent;
    color: var(--ink);
  }
</style>
