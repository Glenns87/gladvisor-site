---
import Button from './Button.astro';
import { getSite, mailtoHref } from '../lib/site';

// Instapproduct: --bg-soft vlak, titel, twee regels uitleg en een knop.
// Titel en uitleg komen uit site.yaml (entryOffers) tenzij de pagina ze
// meegeeft via softConversion. De knop opent een mail met de titel uit
// site.yaml als onderwerp; geen formulier.
interface Props {
  formType: 'seo-quickscan' | 'page-review' | 'ai-check';
  title?: string;
  description?: string;
  buttonLabel?: string;
  id?: string;
}

const { formType, title, description, buttonLabel = 'Aanvragen', id } = Astro.props;
const site = await getSite();
const offer = site.entryOffers[formType];
---

<aside class="entry-offer" id={id} aria-labelledby={`${formType}-titel`}>
  <p class="eyebrow">Eerste stap</p>
  <h2 id={`${formType}-titel`}>{title ?? offer.titel}</h2>
  <p class="entry-offer__text">{description ?? offer.omschrijving}</p>
  <Button href={mailtoHref(site.contact.mail, offer.titel)} variant="secondary">{buttonLabel}</Button>
</aside>

<style>
  .entry-offer {
    display: grid;
    justify-items: start;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-3);
    background: var(--bg-soft);
  }

  .entry-offer__text {
    max-width: var(--measure);
    margin-bottom: var(--space-1);
  }

  @media (min-width: 768px) {
    .entry-offer {
      padding: var(--space-5);
    }
  }
</style>
