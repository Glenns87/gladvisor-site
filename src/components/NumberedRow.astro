---
// Hairline, goud nummer, titel in bold en omschrijving in --muted.
// Mobiel gestapeld; vanaf 768px in drie kolommen. De omschrijving kan ook
// via de slot worden meegegeven.
interface Props {
  number: number;
  title: string;
  description?: string;
  href?: string;
  level?: 3 | 4;
}

const { number, title, description, href, level = 3 } = Astro.props;
const Heading = `h${level}` as 'h3' | 'h4';
const label = String(number).padStart(2, '0');
---

<div class="numbered-row">
  <span class="numbered-row__number" aria-hidden="true">{label}</span>
  <Heading class="numbered-row__title">
    {href ? <a href={href}>{title}</a> : title}
  </Heading>
  <div class="numbered-row__body">
    {description && <p>{description}</p>}
    <slot />
  </div>
</div>

<style>
  .numbered-row {
    display: grid;
    gap: var(--space-1);
    padding-block: var(--space-3);
    border-top: var(--hairline);
  }

  /* Direct onder een sectiekop vervangt diens hairline die van de rij. */
  :global(:is(.section-header, .section-divider)) + .numbered-row {
    padding-top: 0;
    border-top: 0;
  }

  .numbered-row__number {
    color: var(--gold);
    font-size: 28px;
    font-weight: var(--weight-bold);
    line-height: 1;
  }

  .numbered-row__title {
    font-size: var(--fs-h3);
  }

  .numbered-row__body {
    max-width: var(--measure);
    color: var(--muted);
  }

  @media (min-width: 768px) {
    .numbered-row {
      grid-template-columns: 96px minmax(0, 1fr) minmax(0, 2fr);
      gap: var(--space-4);
      padding-block: var(--space-4);
    }
  }
</style>
