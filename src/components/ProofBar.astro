---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { getSite } from '../lib/site';

// --bg-soft vlak met drie cijfers groot in goud, een label eronder en
// optioneel een bron als kleine regel in --muted. Daaronder de logostrip in
// grijs, alleen logo's met visible: true. Zolang een logobestand in public/
// ontbreekt, staat de naam er als gewone tekst.
interface Props {
  items: { value: string; label: string; source?: string }[];
  showLogos?: boolean;
}

const { items, showLogos = true } = Astro.props;
const site = await getSite();
const logos = site.logos
  .filter((logo) => logo.visible)
  .map((logo) => ({ ...logo, exists: existsSync(join(process.cwd(), 'public', logo.file)) }));
---

<section class="proof-bar container" aria-label="Bewijs">
  <div class="proof-bar__inner">
    {
      items.length > 0 && (
        <dl class="proof-bar__stats">
          {items.slice(0, 3).map((item) => (
            <div>
              <dt>{item.label}</dt>
              <dd class="proof-bar__value">{item.value}</dd>
              {item.source && <dd class="proof-bar__source">{item.source}</dd>}
            </div>
          ))}
        </dl>
      )
    }
    {
      showLogos && logos.length > 0 && (
        <div class="proof-bar__logos">
          <p class="eyebrow">Werkte onder meer voor</p>
          <ul>
            {logos.map((logo) => (
              <li>
                {logo.exists ? (
                  <img src={logo.file} alt={logo.name} width="120" height="32" loading="lazy" />
                ) : (
                  logo.name
                )}
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </div>
</section>

<style>
  .proof-bar {
    margin-top: var(--space-4);
  }

  .proof-bar__inner {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-3);
    background: var(--bg-soft);
  }

  .proof-bar__stats {
    display: grid;
    gap: var(--space-3);
  }

  /* Cijfer boven het label; in de HTML staat het label eerst (dt voor dd). */
  .proof-bar__stats > div {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .proof-bar__stats dd {
    margin: 0;
  }

  .proof-bar__value {
    order: -1;
    color: var(--gold);
    font-size: 40px;
    font-weight: var(--weight-bold);
    line-height: 1;
  }

  .proof-bar__stats dt {
    color: var(--text);
    font-size: 15px;
  }

  .proof-bar__source {
    color: var(--muted);
    font-size: var(--fs-small);
  }

  .proof-bar__logos {
    display: grid;
    gap: var(--space-2);
    padding-top: var(--space-3);
    border-top: var(--hairline);
  }

  .proof-bar__logos ul {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-4);
    padding: 0;
    list-style: none;
    color: var(--muted);
    font-size: 17px;
  }

  .proof-bar__logos img {
    height: 32px;
    width: auto;
    filter: grayscale(1);
    opacity: 0.7;
  }

  @media (min-width: 768px) {
    .proof-bar__inner {
      padding: var(--space-5);
    }

    .proof-bar__stats {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-4);
    }

    .proof-bar__value {
      font-size: 48px;
    }
  }
</style>
