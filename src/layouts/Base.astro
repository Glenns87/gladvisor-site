---
import '../styles/tokens.css';
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

// Voorlopig alleen title, description en canonical (plus noindex voor
// /stijlgids/). Open Graph en JSON-LD volgen in een latere sessie.
interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const pathname = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonical = new URL(pathname, Astro.site);
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <a class="skip-link" href="#inhoud">Naar de inhoud</a>
    <Header />
    <main id="inhoud">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    top: var(--space-1);
    left: var(--space-1);
    z-index: 1;
    padding: var(--space-1) var(--space-2);
    background: var(--ink);
    color: var(--bg);
    transform: translateY(-200%);
  }

  .skip-link:focus {
    transform: none;
  }
</style>
