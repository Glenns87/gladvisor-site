---
import '../styles/tokens.css';
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Schema from '../components/Schema.astro';
import type { SchemaInput } from '../lib/schema';

// SEO-basis volgens docs/bouwplan.md stap 3: title, description, canonical
// (eigen URL met slash), Open Graph, Twitter, noindex uit de frontmatter en
// JSON-LD via het Schema-component.
interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  // false voor pagina's zonder eigen URL, zoals de 404.
  canonical?: boolean;
  ogImage?: string;
  ogType?: 'website' | 'article';
  article?: { published: Date; modified?: Date };
  schema?: SchemaInput;
}

const {
  title,
  description,
  noindex = false,
  canonical: withCanonical = true,
  ogImage = '/og-default.png',
  ogType = 'website',
  article,
  schema,
} = Astro.props;

const pathname = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const url = new URL(pathname, Astro.site);
const image = new URL(ogImage, Astro.site);
const isDefaultImage = ogImage === '/og-default.png';
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {withCanonical && <link rel="canonical" href={url} />}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:locale" content="nl_NL" />
    <meta property="og:site_name" content="Gladvisor" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {withCanonical && <meta property="og:url" content={url} />}
    <meta property="og:image" content={image} />
    {
      isDefaultImage && (
        <>
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta property="og:image:alt" content="Gladvisor, freelance SEO-specialist Glenn Snel" />
        </>
      )
    }
    {
      article && (
        <>
          <meta property="article:published_time" content={article.published.toISOString()} />
          {article.modified && <meta property="article:modified_time" content={article.modified.toISOString()} />}
        </>
      )
    }

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    {schema && <Schema {...schema} url={url} title={title} description={description} image={image} />}
  </head>
  <body>
    <a class="skip-link" href="#inhoud">Naar de inhoud</a>
    <Header />
    <main id="inhoud">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    top: var(--space-1);
    left: var(--space-1);
    z-index: 1;
    padding: var(--space-1) var(--space-2);
    background: var(--ink);
    color: var(--bg);
    transform: translateY(-200%);
  }

  .skip-link:focus {
    transform: none;
  }
</style>
